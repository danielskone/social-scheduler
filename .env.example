# Copy this file to .env and fill it in.

# From developers.facebook.com > your app > App settings > Basic
META_APP_ID=
META_APP_SECRET=

# The address this app is reachable at. Instagram downloads your media from here,
# so for Instagram posts this must be a public https address (see README).
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000

# Password for the web dashboard (username can be anything). Strongly recommended once hosted.
APP_PASSWORD=

# Your timezone, used for the calendar and scheduling, e.g. Europe/London or America/New_York
TZ=UTC

GRAPH_VERSION=v23.0

# Optional. Where Facebook returns you after "Connect". Leave blank to use PUBLIC_BASE_URL.
# `npm run mac` sets this to http://localhost:3000 automatically.
OAUTH_BASE_URL=

# Optional. Only if Connect complains about permissions: a configuration ID from
# Meta app > Facebook Login for Business > Configurations.
META_LOGIN_CONFIG_ID=

# Optional: YouTube. From Google Cloud > APIs & Services > Clients (a "Web application"
# client with redirect http://localhost:3000/auth/youtube/callback). Easiest: npm run youtube-keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# public, unlisted or private
YOUTUBE_PRIVACY=public

# Optional: TikTok. From developers.tiktok.com > your app. Easiest: npm run tiktok-keys
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# draft = sent to your TikTok inbox, you tap Post (works before TikTok's audit, can be public)
# direct = posts by itself (private until TikTok approves the app's audit)
TIKTOK_MODE=draft

# Optional: your website's forms -> Contacts (see website-inbox/README.md). Easiest: npm run website
WEBSITE_INBOX_URL=
WEBSITE_INBOX_KEY=
