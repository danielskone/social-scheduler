# Copy this file to .env and fill it in.

# From developers.facebook.com > your app > App settings > Basic
META_APP_ID=
META_APP_SECRET=

# The address this app is reachable at. Instagram downloads your media from here,
# so for Instagram posts this must be a public https address (see README).
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000

# Password for the web dashboard (username can be anything). Strongly recommended once hosted.
APP_PASSWORD=

# Your timezone, used for the calendar and scheduling, e.g. Europe/London or America/New_York
TZ=UTC

GRAPH_VERSION=v23.0

# Optional. Where Facebook returns you after "Connect". Leave blank to use PUBLIC_BASE_URL.
# `npm run mac` sets this to http://localhost:3000 automatically.
OAUTH_BASE_URL=

# Optional. Only if Connect complains about permissions: a configuration ID from
# Meta app > Facebook Login for Business > Configurations.
META_LOGIN_CONFIG_ID=
