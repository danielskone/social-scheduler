{
  "name": "social-scheduler",
  "version": "1.0.0",
  "description": "Personal social media scheduler for Facebook, Instagram, YouTube and TikTok",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "mac": "node scripts/start-with-tunnel.js",
    "background:on": "node scripts/background.js on",
    "background:off": "node scripts/background.js off",
    "background:status": "node scripts/background.js status",
    "update": "sh scripts/update.sh",
    "phone": "node scripts/phone.js",
    "youtube-keys": "node scripts/save-keys.js youtube",
    "tiktok-keys": "node scripts/save-keys.js tiktok"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0"
  },
  "private": true
}
