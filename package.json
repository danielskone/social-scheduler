{
  "name": "social-scheduler",
  "version": "1.0.0",
  "description": "Personal social media scheduler for Facebook, Instagram, YouTube and TikTok",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "saas": "node src/saas/gateway.js",
    "beta": "node scripts/beta.js on",
    "beta:off": "node scripts/beta.js off",
    "beta:status": "node scripts/beta.js status",
    "stripe-setup": "node scripts/stripe-setup.js",
    "test": "node --test test/*.test.js crm/test/*.test.js",
    "mac": "node scripts/start-with-tunnel.js",
    "background:on": "node scripts/background.js on",
    "background:off": "node scripts/background.js off",
    "background:status": "node scripts/background.js status",
    "update": "sh scripts/update.sh",
    "phone": "node scripts/phone.js",
    "youtube-keys": "node scripts/save-keys.js youtube",
    "tiktok-keys": "node scripts/save-keys.js tiktok",
    "password": "node scripts/set-password.js",
    "phone-app": "node scripts/phone-app.js",
    "mac-app": "node scripts/mac-app.js",
    "website": "node crm/scripts/website.js",
    "email-setup": "node crm/scripts/email-setup.js",
    "calendar": "node crm/scripts/calendar.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "sherpa-onnx-node": "^2.0.1"
  },
  "private": true
}
